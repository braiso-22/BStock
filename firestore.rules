rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{itemId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.minimum is int
        && request.resource.data.minimum >= 0
        && request.resource.data.imageUrl is string
        && request.resource.data.get('priceCents', 0) is int
        && request.resource.data.get('priceCents', 0) >= 0
        && request.resource.data.get('packSize', 1) is int
        && request.resource.data.get('packSize', 1) >= 1;
    }
  }
}
